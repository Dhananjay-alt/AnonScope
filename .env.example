# Observer
PORT=8787
DB_PATH=./data/anonscope.db
# Header carrying the real client IP, set by the hosting proxy. Fly.io: Fly-Client-IP.
# Leave empty to use the socket address (local dev). Never set to X-Forwarded-For
# unless your proxy overwrites it.
TRUSTED_IP_HEADER=
UPSTREAM_RPC_MAINNET=https://ethereum-rpc.publicnode.com
UPSTREAM_RPC_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
# Public HTTPS origin of the observer (what Tor exits must reach), e.g. https://anonscope.fly.dev
PUBLIC_ORIGIN=http://localhost:8787
# Shared secret the scheduled runner passes (via the /run page) to claim scheduled runs.
# Empty = scheduled runs are open (dev only).
RUNNER_TOKEN=
# Directory with the built web app
WEB_DIST=../web/dist

# Runner
# RUNNER_NETWORKS=passthrough,tor-js,nym,nox
# RUNNER_HEADLESS=new        # new | old | false
# RUNNER_INTERVAL_MIN=30
# RUNNER_HOST_RESOLVER_RULES="MAP app.fly.dev 1.2.3.4"   # only if local DNS lags behind a fresh deploy
