# Scheduled runner: headless Chromium (Playwright) opening the observer's /run
# page ONCE per machine start. Fly starts the machine on a schedule (see
# fly.runner.toml); the machine stops when this process exits.
FROM node:22-bookworm
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/observer/package.json packages/observer/
COPY packages/web/package.json packages/web/
COPY packages/runner/package.json packages/runner/
COPY spikes/package.json spikes/
RUN pnpm install --frozen-lockfile --filter "@anonscope/runner..."
COPY packages/runner packages/runner
# Browser + its system libraries, at the version matching the installed playwright.
RUN cd packages/runner && ./node_modules/.bin/playwright install --with-deps chromium
WORKDIR /app/packages/runner
ENV RUNNER_HEADLESS=new RUNNER_TIMEOUT_MIN=18
# Hard cap: SIGTERM at 20 min, SIGKILL 30 s later. Exit, so the machine stops.
CMD ["timeout", "--kill-after=30s", "20m", "./node_modules/.bin/tsx", "src/run.ts"]
