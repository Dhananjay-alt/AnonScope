# Scheduled runner: headless Chromium (Playwright) opening the observer's
# /run page every RUNNER_INTERVAL_MIN minutes. Separate app from the observer.
FROM node:22-bookworm
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/observer/package.json packages/observer/
COPY packages/web/package.json packages/web/
COPY packages/runner/package.json packages/runner/
COPY spikes/package.json spikes/
RUN pnpm install --frozen-lockfile --filter "@anonscope/runner..."
COPY packages/runner packages/runner
# Browser + its system libraries, at the version matching the installed playwright.
RUN cd packages/runner && ./node_modules/.bin/playwright install --with-deps chromium
WORKDIR /app/packages/runner
ENV RUNNER_HEADLESS=new RUNNER_INTERVAL_MIN=30
CMD ["./node_modules/.bin/tsx", "src/loop.ts"]
